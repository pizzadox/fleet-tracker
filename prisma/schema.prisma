generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Company {
  id          String   @id @default(cuid())
  name        String
  inn         String?  // ИНН
  kpp         String?  // КПП
  ogrn        String?  // ОГРН
  address     String?  // Юридический адрес
  factAddress String?  // Фактический адрес
  phone       String?
  email       String?
  director    String?  // ФИО директора
  type        String   @default("owner") // owner | renter | both
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  ownedEquipment  Equipment[] @relation("OwnerCompany")
  rentedEquipment Equipment[] @relation("RenterCompany")
}

model Equipment {
  id              String   @id @default(cuid())
  name            String   // Наименование техники
  type            String   // Тип: автомобиль, спецтехника, прицеп и т.д.
  brand           String?  // Марка
  model           String?  // Модель
  year            Int?     // Год выпуска
  vin             String?  // VIN номер
  serialNumber    String?  // Серийный номер
  registrationNum String?  // Государственный номер
  stsNumber       String?  // Номер СТС
  ptsNumber       String?  // Номер ПТС
  category        String?  // Категория (B, C, D и т.д.)
  color           String?  // Цвет
  engineType      String?  // Тип двигателя
  engineVolume    String?  // Объём двигателя
  enginePower     String?  // Мощность (л.с.)
  mileage         Int?     // Пробег (км)
  fuelType        String?  // Тип топлива
  loadCapacity    String?  // Грузоподъёмность
  passengerSeats  Int?     // Количество пассажирских мест
  purchaseDate    DateTime? // Дата приобретения
  purchasePrice   Float?   // Цена приобретения
  currentPrice    Float?   // Текущая стоимость
  insuranceNumber String?  // Номер полиса ОСАГО/КАСКО
  insuranceExpiry DateTime? // Срок действия страховки
  inspectionDate  DateTime? // Дата техосмотра
  inspectionExpiry DateTime? // Срок действия ТО
  status          String   @default("active") // active | repair | decommissioned | rented
  notes           String?  // Дополнительные заметки
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  ownerId         String?  // Компания-владелец
  owner           Company? @relation("OwnerCompany", fields: [ownerId], references: [id])
  renterId        String?  // Компания-арендатор
  renter          Company? @relation("RenterCompany", fields: [renterId], references: [id])

  photos          EquipmentPhoto[]
  repairs         Repair[]
  history         EquipmentHistory[]
  documents       EquipmentDocument[]
  trackers        GlonassTracker[]
  trips           Trip[]
  notificationRules NotificationRule[]
  employees       Employee[]
}

model EquipmentPhoto {
  id          String   @id @default(cuid())
  equipmentId String
  url         String   // Путь к файлу
  description String?  // Описание фото
  category    String   @default("general") // general | document | damage | repair
  createdAt   DateTime @default(now())

  equipment   Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
}

model Repair {
  id            String   @id @default(cuid())
  equipmentId   String
  description   String   // Описание ремонта
  reason        String?  // Причина ремонта
  startDate     DateTime // Дата начала
  endDate       DateTime? // Дата окончания
  status        String   @default("in_progress") // in_progress | completed | cancelled
  cost          Float?   // Стоимость ремонта
  contractor    String?  // Подрядчик/СТО
  contractorPhone String? // Телефон подрядчика
  workPerformed String?  // Выполненные работы
  spareParts    String?  // Запчасти
  nextInspection DateTime? // Дата следующего ТО после ремонта
  notes         String?  // Заметки
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  equipment     Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  photos        RepairPhoto[]
  stages        RepairStage[]
  masters       RepairEmployee[]
}

model RepairEmployee {
  id          String   @id @default(cuid())
  repairId    String
  employeeId  String
  role        String   @default("master") // master | assistant | supervisor
  assignedAt  DateTime @default(now())
  notes       String?

  repair      Repair   @relation(fields: [repairId], references: [id], onDelete: Cascade)
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([repairId, employeeId])
}

model RepairStage {
  id          String   @id @default(cuid())
  repairId    String
  name        String   // Название этапа
  description String?  // Описание этапа
  status      String   @default("pending") // pending | in_progress | completed
  startDate   DateTime? // Дата начала этапа
  endDate     DateTime? // Дата окончания этапа
  performer   String?  // Исполнитель
  cost        Float?   // Стоимость этапа
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  repair      Repair   @relation(fields: [repairId], references: [id], onDelete: Cascade)
}

model RepairPhoto {
  id          String   @id @default(cuid())
  repairId    String
  url         String   // Путь к файлу
  description String?  // Описание фото
  stageId     String?  // Привязка к этапу ремонта
  createdAt   DateTime @default(now())

  repair      Repair   @relation(fields: [repairId], references: [id], onDelete: Cascade)
}

model EquipmentHistory {
  id          String   @id @default(cuid())
  equipmentId String
  event       String   // Тип события: registration, transfer, repair, inspection, rental, decommission
  description String?  // Описание события
  date        DateTime // Дата события
  oldValue     String? // Старое значение
  newValue     String? // Новое значение
  performedBy String?  // Кто выполнил
  createdAt   DateTime @default(now())

  equipment   Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
}

model EquipmentDocument {
  id          String   @id @default(cuid())
  equipmentId String
  name        String   // Название документа
  type        String   // Тип: sts, pts, insurance, contract, act, other
  url         String   // Путь к файлу
  expiryDate  DateTime? // Срок действия
  notes       String?
  createdAt   DateTime @default(now())

  equipment   Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
}

model GlonassTracker {
  id             String   @id @default(cuid())
  equipmentId    String   // Привязка к технике
  trackerId      String   // ID трекера в Axenta.cloud
  trackerName    String?  // Название трекера
  imei           String?  // IMEI устройства
  phoneNumber    String?  // Номер SIM-карты трекера
  lastLatitude   Float?   // Последняя широта
  lastLongitude  Float?   // Последняя долгота
  lastSpeed      Float?   // Последняя скорость (км/ч)
  lastCourse     Float?   // Последний курс (градусы)
  lastAltitude   Float?   // Последняя высота (м)
  lastIgnition   Boolean? @default(false) // Зажигание
  lastFuelLevel  Float?   // Уровень топлива (%)
  lastMileage    Float?   // Пробег по трекеру (км)
  lastEngineTemp Float?   // Температура двигателя
  lastAddress    String?  // Последний адрес (обратное геокодирование)
  lastSeenAt     DateTime? // Последний выход на связь
  lastPositionAt DateTime? // Время последней позиции
  axentaCloudId  String?  // ID объекта в Axenta.cloud (integer)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  equipment      Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  sensorData     GlonassSensorData[]
}

model GlonassSensorData {
  id           String   @id @default(cuid())
  trackerId    String
  sensorType   String   // Тип датчика: fuel, temperature, ignition, mileage, speed, door, custom
  sensorName   String?  // Название датчика
  value        Float?   // Числовое значение
  stringValue  String?  // Строковое значение
  unit         String?  // Единица измерения
  timestamp    DateTime // Время замера
  createdAt    DateTime @default(now())

  tracker      GlonassTracker @relation(fields: [trackerId], references: [id], onDelete: Cascade)
}

model Employee {
  id             String    @id @default(cuid())
  fullName       String    // ФИО сотрудника
  position       String    // driver | mechanic | assistant | loader | other
  phone          String?
  email          String?
  birthDate      DateTime? // Дата рождения
  hireDate       DateTime? // Дата приёма на работу
  fireDate       DateTime? // Дата увольнения
  licenseNum     String?   // Номер водительского удостоверения
  licenseCat     String?   // Категория ВУ (B, C, D, CE...)
  licenseExpiry  DateTime? // Срок действия ВУ
  passportSeries String?   // Серия паспорта
  passportNum    String?   // Номер паспорта
  address        String?   // Адрес проживания
  status         String    @default("active") // active | dismissed | vacation | sick
  salary         Float?    // Зарплата
  notes          String?
  crewId         String?   // Привязка к экипажу
  equipmentId    String?   // Назначенная техника
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  crew           Crew?     @relation(fields: [crewId], references: [id], onDelete: SetNull)
  equipment      Equipment? @relation(fields: [equipmentId], references: [id], onDelete: SetNull)
  repairAssignments RepairEmployee[]
  crewMembers    CrewMember[]
}

model Crew {
  id          String   @id @default(cuid())
  name        String   // Название экипажа / бригады
  description String?  // Описание
  type        String   @default("driver") // driver | mechanic | mixed | other
  status      String   @default("active") // active | inactive
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members     CrewMember[]
  employees   Employee[]
  trips       Trip[]
}

model CrewMember {
  id          String   @id @default(cuid())
  crewId      String
  employeeId  String?  // Привязка к сотруднику (если выбран из списка)
  fullName    String   // ФИО члена экипажа
  role        String   // driver | mechanic | assistant | loader | other
  phone       String?  // Телефон
  licenseNum  String?  // Номер водительского удостоверения
  licenseCat  String?  // Категория ВУ (B, C, D, CE...)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  crew        Crew     @relation(fields: [crewId], references: [id], onDelete: Cascade)
  employee    Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  @@unique([crewId, employeeId])
}

model Trip {
  id              String   @id @default(cuid())
  equipmentId     String   // Привязка к технике
  crewId          String?  // Привязка к экипажу
  route           String   // Маршрут (откуда — куда)
  startPoint      String?  // Пункт отправления
  endPoint        String?  // Пункт назначения
  cargo           String?  // Груз
  cargoWeight     Float?   // Вес груза (т)
  distance        Float?   // Расстояние (км)
  startDate       DateTime // Дата/время начала рейса
  endDate         DateTime? // Дата/время окончания рейса
  plannedEndDate  DateTime? // Планируемое время прибытия
  status          String   @default("planned") // planned | in_progress | completed | cancelled
  fuelStart       Float?   // Топливо на старте (л)
  fuelEnd         Float?   // Топливо на финише (л)
  mileageStart    Int?     // Пробег на старте
  mileageEnd      Int?     // Пробег на финише
  cost            Float?   // Стоимость рейса
  revenue         Float?   // Доход от рейса
  notes           String?
  // ── Аналитика трекера (заполняется при завершении рейса) ──
  avgSpeed        Float?   // Средняя скорость (км/ч)
  maxSpeed        Float?   // Максимальная скорость (км/ч)
  fuelConsumed    Float?   // Израсходовано топлива (л)
  tripDuration    Int?     // Длительность рейса (секунды)
  engineHours     Float?   // Моточасы
  avgFuelRate     Float?   // Средний расход (л/100км)
  refuelVolume    Float?   // Заправки (л)
  plumVolume      Float?   // Сливы (л)
  idleTime        Int?     // Холостой ход (секунды)
  parkingsDuration Int?    // Время стоянок (секунды)
  trackerSnapshot     String?  // JSON-снапшот данных трекера на момент завершения
  trackerSnapshotStart String? // JSON-снапшот данных трекера на момент старта
  trackDataJson       String? // Кэшированные данные трека (поездки, стоянки, заправки и т.д.)
  trackDataLoadedAt   DateTime? // Время загрузки кэшированного трека
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  routeTemplateId String?   // Привязка к шаблону маршрута
  routePoints     RoutePoint[]
  equipment       Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  crew            Crew?     @relation(fields: [crewId], references: [id], onDelete: SetNull)
  routeTemplate   RouteTemplate? @relation(fields: [routeTemplateId], references: [id], onDelete: SetNull)
}

model RoutePoint {
  id              String    @id @default(cuid())
  tripId          String
  name            String    // Name/description of the point
  address         String?   // Full address
  latitude        Float?    // Coordinates for distance calculation
  longitude       Float?    // Coordinates for distance calculation
  sortOrder       Int       @default(0) // Order in the route
  plannedArrival  DateTime? // Planned arrival time
  plannedDeparture DateTime? // Planned departure time
  actualArrival   DateTime? // Actual arrival time (from tracker)
  distanceFromPrev Float?   // Distance from previous point (km)
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  trip            Trip      @relation(fields: [tripId], references: [id], onDelete: Cascade)
}

model RouteTemplate {
  id                String    @id @default(cuid())
  name              String    // Название маршрута
  description       String?   // Описание
  startPoint        String?   // Пункт отправления
  endPoint          String?   // Пункт назначения
  totalDistance      Float?    // Общее расстояние (км)
  estimatedDuration Int?      // Ориентировочное время (минуты)
  notes             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  points            RouteTemplatePoint[]
  trips             Trip[]
}

model RouteTemplatePoint {
  id               String    @id @default(cuid())
  routeTemplateId  String
  name             String    // Название/описание точки
  address          String?   // Полный адрес
  latitude         Float?    // Координаты
  longitude        Float?    // Координаты
  sortOrder        Int       @default(0) // Порядок в маршруте
  plannedArrival   String?   // Планируемое время прибытия (HH:mm или относительное)
  plannedDeparture String?   // Планируемое время отправления
  distanceFromPrev Float?    // Расстояние от предыдущей точки (км)
  notes            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  routeTemplate    RouteTemplate @relation(fields: [routeTemplateId], references: [id], onDelete: Cascade)
}

model AxentaSettings {
  id           String   @id @default(cuid())
  apiUrl       String   // URL API Axenta.cloud
  apiKey       String   // API-ключ
  username     String?  // Логин
  password     String?  // Пароль (зашифрованный)
  syncInterval Int      @default(300) // Интервал синхронизации (секунды)
  lastSyncAt   DateTime? // Последняя синхронизация
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model NotificationRule {
  id              String    @id @default(cuid())
  equipmentId     String    // Привязка к технике
  conditionType   String    // Тип условия: offline, not_synced, not_moving, speed_exceeded, fuel_low, zone_exit
  thresholdValue  Float?    // Пороговое значение (часы для not_synced/not_moving, км/ч для speed_exceeded, % для fuel_low)
  isActive        Boolean   @default(true)
  lastTriggeredAt DateTime? // Последнее срабатывание
  description     String?   // Описание правила
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  equipment       Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
}
